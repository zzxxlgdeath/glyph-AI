<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.nothing.ketchum" />

    <!-- Nothing Phone (3) Glyph Matrix SDK permission -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Voice recognition, lock-screen foreground microphone service, and AI API networking -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required on Android 11+ (targetSdk 36) so bindService to Nothing GlyphService & SpeechRecognizer succeeds -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
        <package android:name="com.nothing.ketchum" />
        <intent>
            <action android:name="com.nothing.thirdparty.bind_glyphservice" />
        </intent>
        <intent>
            <action android:name="com.nothing.glyph.TOY" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nothing Phone (3) Glyph Toy Service with foregroundServiceType="microphone" for locked-screen voice -->
        <service
            android:name=".glyph.GlyphOracleToyService"
            android:exported="true"
            android:foregroundServiceType="microphone">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <!-- Required: Name in Nothing OS Glyph Toys manager -->
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_oracle" />

            <!-- Required: Preview image in Nothing OS Glyph Toys settings -->
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_glyph_oracle_preview" />

            <!-- Optional: Summary description -->
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_oracle" />

            <!-- Optional: Links to MainActivity introduction/configuration screen -->
            <meta-data
                android:name="com.nothing.glyph.toy.introduction"
                android:value="com.example.MainActivity" />

            <!-- Enables long press (EVENT_CHANGE) on the back Glyph Button -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />

            <!-- Enables Always-On Display (AOD) support -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>
    </application>

</manifest>
